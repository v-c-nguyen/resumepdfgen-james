// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id           String   @id @default(cuid())
  name         String   @unique
  resumeText   String   @db.Text
  customStage1Prompt String? @db.Text
  customStage2Prompt String? @db.Text
  customStage3Prompt String? @db.Text
  customStage4Prompt String? @db.Text
  pdfTemplate  Int      @default(1)
  email        String?
  phoneNumber  String?
  fullAddress  String?
  linkedinUrl       String?
  industry          String?
  jobDescription    String?  @db.Text
  targetTitle       String?
  logGenerations    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("profiles")
}

model DefaultPromptSettings {
  id           String   @id @default("default")
  stage1Prompt       String?  @db.Text
  stage2Prompt       String?  @db.Text
  qaPrompt           String?  @db.Text
  coverLetterPrompt  String?  @db.Text
  resumePrompt       String?  @db.Text
  updatedAt          DateTime @updatedAt

  @@map("default_prompt_settings")
}

model ResumeGenerationLog {
  id             String   @id @default(cuid())
  profileName    String?
  jobDescription String?  @db.Text
  resumeText     String   @db.Text
  company        String?
  role           String?
  createdAt      DateTime @default(now())

  @@map("resume_generation_logs")
}
